{
  "name": "photo-sorter",
  "version": "1.0.0",
  "description": "Local-first photo and video sorter",
  "main": "src/electron/main.js",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "npm run test:unit && npm run test:e2e && npm run test:browser",
    "test:unit": "node --test test/unit/*.test.js",
    "test:e2e": "node --test test/e2e/*.test.js",
    "test:browser": "playwright test",
    "build": "electron-builder --dir",
    "reset-password": "node scripts/reset-password.js",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "lint": "eslint ."
  },
  "build": {
    "appId": "local.photosorter",
    "productName": "Photo Sorter",
    "files": [
      "src/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0"
  },
  "overrides": {
    "@electron/get": "^5.1.0"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "exifr": "^7.1.3",
    "qrcode": "^1.5.4"
  }
}
